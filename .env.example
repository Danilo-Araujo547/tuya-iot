# Use nome DNS acessível na LAN/VPN. Não inclua https://.
APP_HOST=localhost
# Mude para o IP privado específico do servidor, nunca para um IP público.
BIND_ADDRESS=127.0.0.1
# Configure armazenamento separado antes da operação real.
BACKUP_PATH=./backups
# Ajuste à região efetiva do projeto Tuya.
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_PULSAR_ENDPOINT=wss://mqe.tuyaus.com:8285/
TUYA_CALLS_PER_MINUTE=30
# Intervalo de reconciliação Cloud. Para um único sensor, 300 equivale a 5 minutos.
TUYA_RECONCILE_SECONDS=3600
